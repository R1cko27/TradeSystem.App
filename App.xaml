<Application x:Class="TradeSystem.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmProd="clr-namespace:TradeSystem.App.ViewModels.Products"
             xmlns:vmSup="clr-namespace:TradeSystem.App.ViewModels.Suppliers"
             xmlns:vmShelf="clr-namespace:TradeSystem.App.ViewModels.Shelves"
             xmlns:vmSp="clr-namespace:TradeSystem.App.ViewModels.SupplierProducts"
             xmlns:vmOrd="clr-namespace:TradeSystem.App.ViewModels.Orders"
             xmlns:vmInv="clr-namespace:TradeSystem.App.ViewModels.Invoices"
             xmlns:vmRec="clr-namespace:TradeSystem.App.ViewModels.Receipts"
             xmlns:vmSale="clr-namespace:TradeSystem.App.ViewModels.Sales"
             xmlns:vmRep="clr-namespace:TradeSystem.App.ViewModels.Reports"
             xmlns:views="clr-namespace:TradeSystem.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vmProd:ProductsListViewModel}"><views:ProductsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmProd:ProductEditViewModel}"><views:ProductEditView/></DataTemplate>

            <DataTemplate DataType="{x:Type vmSup:SuppliersListViewModel}"><views:SuppliersView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmSup:SupplierEditViewModel}"><views:SupplierEditView/></DataTemplate>

            <DataTemplate DataType="{x:Type vmShelf:ShelvesListViewModel}"><views:ShelvesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmShelf:ShelfEditViewModel}"><views:ShelfEditView/></DataTemplate>

            <DataTemplate DataType="{x:Type vmSp:SupplierProductsListViewModel}"><views:SupplierProductsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmSp:SupplierProductEditViewModel}"><views:SupplierProductEditView/></DataTemplate>

            <DataTemplate DataType="{x:Type vmOrd:OrdersListViewModel}"><views:OrdersView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmOrd:OrderAutoPreviewViewModel}"><views:OrderAutoPreviewView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmOrd:OrderManualEditViewModel}"><views:OrderManualEditView/></DataTemplate>

            <DataTemplate DataType="{x:Type vmInv:InvoiceListViewModel}"><views:InvoiceListView/></DataTemplate>

            <DataTemplate DataType="{x:Type vmRec:ReceiptsListViewModel}"><views:ReceiptsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmRec:ReceiptEditViewModel}"><views:ReceiptEditView/></DataTemplate>

            <DataTemplate DataType="{x:Type vmSale:SalesListViewModel}"><views:SalesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vmSale:SaleEditViewModel}"><views:SaleEditView/></DataTemplate>

            <DataTemplate DataType="{x:Type vmRep:ReportsViewModel}"><views:ReportsView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>