<Window x:Class="TradeSystem.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trade System — учет товаров и заказов поставщикам"
        Height="680" Width="1120" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="190" Background="#F7F7F9"
                BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="8,12">
                <TextBlock Text="TRADE SYSTEM" FontWeight="Bold" FontSize="15" Margin="6,0,0,12" Foreground="#2C3E50"/>
                <Button Style="{StaticResource MenuButton}" Content="📦 Товары" Command="{Binding ProductsCommand}"/>
                <Button Style="{StaticResource MenuButton}" Content="🚚 Поставщики" Command="{Binding SuppliersCommand}"/>
                <Button Style="{StaticResource MenuButton}" Content="🗄 Полки" Command="{Binding ShelvesCommand}"/>
                <Button Style="{StaticResource MenuButton}" Content="🔗 Поставки товара" Command="{Binding SupplierProductsCommand}"/>
                <Separator Margin="4,8"/>
                <Button Style="{StaticResource MenuButton}" Content="🧾 Заказы" Command="{Binding OrdersCommand}"/>
                <Button Style="{StaticResource MenuButton}" Content="📥 Поступления" Command="{Binding ReceiptsCommand}"/>
                <Button Style="{StaticResource MenuButton}" Content="📤 Продажи" Command="{Binding SalesCommand}"/>
                <Separator Margin="4,8"/>
                <Button Style="{StaticResource MenuButton}" Content="🖨 Отчеты" Command="{Binding ReportsCommand}"/>
            </StackPanel>
        </Border>
        <ContentControl Content="{Binding CurrentViewModel}" Margin="0"/>
    </DockPanel>
</Window>