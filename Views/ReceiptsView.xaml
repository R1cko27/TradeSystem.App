<UserControl x:Class="TradeSystem.App.Views.ReceiptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="360"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="2*" MinWidth="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" LastChildFill="True" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}" Margin="6,0,0,0" Padding="10,4"/>
            <Button DockPanel.Dock="Right" Content="＋ Новое поступление" Command="{Binding NewCommand}" Margin="6,0,0,0" Padding="10,4" FontWeight="SemiBold"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="4"
                     ToolTip="Поиск по номеру поступления или поставщику"/>
        </DockPanel>

        <DataGrid Grid.Row="1" Grid.Column="0"
                  ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedReceipt}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="130"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName}" Width="*"/>
                <DataGridTextColumn Header="Заказ" Binding="{Binding OrderNumber}" Width="130"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding ReceivedAtUtc, StringFormat=dd.MM.yyyy}" Width="90"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusLabel}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Детали поступления" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Text="Выберите поступление слева" Foreground="Gray"
                               Visibility="{Binding SelectedReceipt, Converter={StaticResource NullToVis}}"/>
                    <StackPanel Visibility="{Binding SelectedReceipt, Converter={StaticResource NotNullToVis}}">
                        <TextBlock><Run Text="Номер: "/><Run Text="{Binding SelectedReceipt.Number, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                        <TextBlock><Run Text="Поставщик: "/><Run Text="{Binding SelectedReceipt.SupplierName, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="Заказ: "/><Run Text="{Binding SelectedReceipt.OrderNumber, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="Статус: "/><Run Text="{Binding SelectedReceipt.StatusLabel, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </StackPanel>

                <DataGrid Grid.Row="1" Margin="0,8"
                          ItemsSource="{Binding SelectedReceipt.Lines}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Visibility="{Binding SelectedReceipt, Converter={StaticResource NotNullToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Полка" Binding="{Binding ShelfName}" Width="120"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Провести" Command="{Binding PostCommand}" Padding="10,4" Margin="0,0,6,0" FontWeight="SemiBold"/>
                    <Button Content="Удалить черновик" Command="{Binding DeleteCommand}" Padding="10,4"/>
                    <TextBlock Text="Загрузка..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>