<UserControl x:Class="TradeSystem.App.Views.SupplierProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ряд 1: поиск + активность + действия -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Обновить"
                    Command="{Binding RefreshCommand}" Margin="6,0,0,0" Padding="10,4"/>
            <Button DockPanel.Dock="Right" Content="Добавить"
                    Command="{Binding AddCommand}" Margin="6,0,0,0" Padding="10,4" FontWeight="SemiBold"/>
            <CheckBox DockPanel.Dock="Right" Content="Показывать неактивные"
                      IsChecked="{Binding ShowInactive}" VerticalAlignment="Center" Margin="12,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Padding="4"
                     ToolTip="Поиск по товару, поставщику или артикулу поставщика"/>
        </DockPanel>

        <!-- Ряд 2: фильтры по товару и поставщику -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Товар:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="240" Margin="0,0,18,0"
                      ItemsSource="{Binding ProductFilters}"
                      SelectedValuePath="Id" DisplayMemberPath="Name"
                      SelectedValue="{Binding FilterProductId}"/>
            <TextBlock Text="Поставщик:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="240"
                      ItemsSource="{Binding SupplierFilters}"
                      SelectedValuePath="Id" DisplayMemberPath="Name"
                      SelectedValue="{Binding FilterSupplierId}"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="180"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName}" Width="160"/>
                <DataGridTextColumn Header="Арт. поставщика" Binding="{Binding SupplierArticle}" Width="130"/>
                <DataGridTextColumn Header="Цена закупки" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Срок, дн." Binding="{Binding LeadTimeDays}" Width="70"/>
                <DataGridTextColumn Header="Мин. заказ" Binding="{Binding MinimumOrderQuantity}" Width="80"/>
                <DataGridTextColumn Header="Кратность" Binding="{Binding OrderMultiple}" Width="80"/>
                <DataGridTemplateColumn Header="Предпочт." Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreferred}" Value="True">
                                                <Setter Property="Text" Value="★"/>
                                                <Setter Property="Foreground" Value="#D4A017"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Активна" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Нет"/>
                                        <Setter Property="Foreground" Value="#7F8C8D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Text" Value="Да"/>
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Изменить" Command="{Binding EditCommand}" Padding="10,4" Margin="0,0,6,0"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,4"/>
            <TextBlock Text="Загрузка..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>