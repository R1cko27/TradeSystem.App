<!-- Views/ProductEditView.xaml -->
<UserControl x:Class="TradeSystem.App.Views.ProductEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Редактирование товара"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter Property="Text" Value="Новый товар"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование *" VerticalAlignment="Center" Margin="0,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Артикул *" VerticalAlignment="Center" Margin="0,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6"
                         Text="{Binding Article, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Единица измерения" VerticalAlignment="Center" Margin="0,6"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6"
                          ItemsSource="{Binding AvailableUnits}"
                          SelectedValuePath="Value" DisplayMemberPath="Label"
                          SelectedValue="{Binding Unit}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Минимальный остаток" VerticalAlignment="Center" Margin="0,6"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6"
                         Text="{Binding MinimumStockQuantity, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Целевой остаток" VerticalAlignment="Center" Margin="0,6"/>
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6"
                         Text="{Binding TargetStockText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Пусто = не задан. Используется при автоформировании заказа."/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Полка по умолчанию" VerticalAlignment="Center" Margin="0,6"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,6"
                          ItemsSource="{Binding Shelves}"
                          SelectedValuePath="Id" DisplayMemberPath="Name"
                          SelectedValue="{Binding DefaultShelfId}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}"
                        Padding="14,6" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="14,6"/>
                <TextBlock Text="Загрузка..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>