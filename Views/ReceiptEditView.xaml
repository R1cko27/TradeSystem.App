<!-- Views/ReceiptEditView.xaml -->
<!-- Файл содержит представление формы создания поступления товара с выбором режима, поставщика, заказа и позиций. -->

<UserControl x:Class="TradeSystem.App.Views.ReceiptEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmRec="clr-namespace:TradeSystem.App.ViewModels.Receipts">
    <UserControl.Resources>
        <!-- Шаблон видимости: элемент виден только когда SourceMode == заданному значению -->
        <Style x:Key="VisibleWhenByOrder" TargetType="FrameworkElement"> <!-- Видимость в режиме «по заказу» -->
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SourceMode}" Value="{x:Static vmRec:ReceiptSourceMode.ByOrder}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VisibleWhenFree" TargetType="FrameworkElement"> <!-- Видимость в свободном режиме -->
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SourceMode}" Value="{x:Static vmRec:ReceiptSourceMode.Free}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Новое поступление товара" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/> <!-- Заголовок формы -->

        <!-- Режим + поставщик -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Режим:" VerticalAlignment="Center" Margin="0,0,6,0"/> <!-- Подпись режима -->
            <ComboBox Width="200" Margin="0,0,24,0"
                      SelectedValuePath="Tag" DisplayMemberPath="Content"
                      SelectedValue="{Binding SourceMode}">
                <ComboBoxItem Content="По заказу поставщика" Tag="{x:Static vmRec:ReceiptSourceMode.ByOrder}"/> <!-- Режим «по заказу» -->
                <ComboBoxItem Content="Свободное поступление" Tag="{x:Static vmRec:ReceiptSourceMode.Free}"/> <!-- Свободный режим -->
            </ComboBox>
            <TextBlock Text="Поставщик *" VerticalAlignment="Center" Margin="0,0,6,0"/> <!-- Подпись поставщика -->
            <ComboBox Width="240" ItemsSource="{Binding Suppliers}" SelectedValuePath="Id" DisplayMemberPath="Name"
                      SelectedValue="{Binding SupplierId}"/> <!-- Выбор поставщика -->
        </StackPanel>

        <!-- Ряд заказа (только ByOrder) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" Style="{StaticResource VisibleWhenByOrder}">
            <TextBlock Text="Заказ:" VerticalAlignment="Center" Margin="0,0,6,0"/> <!-- Подпись заказа -->
            <ComboBox Width="280" Margin="0,0,12,0"
                      ItemsSource="{Binding OrdersForSupplier}" SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedOrderId}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold"/> <!-- Номер заказа -->
                            <TextBlock Text="{Binding OrderDateUtc, StringFormat='  ·  dd.MM.yyyy'}" Foreground="Gray"/> <!-- Дата заказа -->
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Загрузить позиции заказа" Command="{Binding LoadOrderLinesCommand}" Padding="8,3"/> <!-- Загрузить строки заказа -->
        </StackPanel>

        <!-- Панель строк (заголовок + кнопки) -->
        <DockPanel Grid.Row="3" VerticalAlignment="Top" Height="34" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="－ Удалить строку" Command="{Binding RemoveLineCommand}" Margin="6,0,0,0" Padding="8,3"/> <!-- Удалить выбранную строку -->
            <Button DockPanel.Dock="Right" Content="＋ Строка" Command="{Binding AddLineCommand}" Padding="8,3"
                    Style="{StaticResource VisibleWhenFree}"/> <!-- Добавить строку в свободном режиме -->
            <TextBlock Text="Позиции поступления" VerticalAlignment="Center" FontWeight="SemiBold"/> <!-- Заголовок блока позиций -->
        </DockPanel>

        <DataGrid Grid.Row="3" Margin="0,38,0,0"
                  ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Товар" Width="*"> <!-- Выбор товара -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValuePath="ProductId" DisplayMemberPath="ProductName"
                                      SelectedValue="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsProductEditable}"
                                      BorderThickness="0" Background="Transparent"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Полка *" Width="200"> <!-- Выбор полки -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Shelves, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValuePath="Id" SelectedValue="{Binding ShelfId, UpdateSourceTrigger=PropertyChanged}"
                                      BorderThickness="0" Background="Transparent">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold"/> <!-- Код полки -->
                                            <TextBlock Text="{Binding Name, StringFormat='  ·  {0}'}" Foreground="Gray"/> <!-- Название полки -->
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80"/> <!-- Количество -->
                <DataGridTextColumn Header="Макс. (остаток заказа)" Binding="{Binding MaxQuantity}" Width="140" IsReadOnly="True"/> <!-- Максимальное количество -->
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="В режиме «по заказу» товар зафиксирован строкой заказа, количество можно уменьшить (частичный приход). Полку выбираете вы — по заданию. В свободном режиме добавляйте строки кнопкой «＋ Строка»."/> <!-- Подсказка по работе формы -->

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Сохранить черновик" Command="{Binding SaveDraftCommand}" Padding="14,6" Margin="0,0,8,0"/> <!-- Сохранить черновик -->
            <Button Content="Сохранить и провести" Command="{Binding SaveAndPostCommand}" Padding="14,6" FontWeight="SemiBold" Margin="0,0,8,0"/> <!-- Сохранить и провести -->
            <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="14,6"/> <!-- Отмена -->
            <TextBlock Text="Загрузка..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/> <!-- Индикатор загрузки -->
        </StackPanel>
    </Grid>
</UserControl>