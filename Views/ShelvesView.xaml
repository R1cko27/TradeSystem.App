<UserControl x:Class="TradeSystem.App.Views.ShelvesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Обновить"
                    Command="{Binding RefreshCommand}" Margin="6,0,0,0" Padding="10,4"/>
            <Button DockPanel.Dock="Right" Content="Добавить"
                    Command="{Binding AddCommand}" Margin="6,0,0,0" Padding="10,4" FontWeight="SemiBold"/>
            <CheckBox DockPanel.Dock="Right" Content="Показывать неактивные"
                      IsChecked="{Binding ShowInactive}" VerticalAlignment="Center" Margin="12,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Padding="4"
                     ToolTip="Поиск по коду, названию или расположению"/>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="120"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Расположение" Binding="{Binding Location}" Width="2*"/>
                <DataGridTextColumn Header="Товаров" Binding="{Binding ProductsCount}" Width="90"/>
                <DataGridTemplateColumn Header="Активна" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Нет"/>
                                        <Setter Property="Foreground" Value="#7F8C8D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Text" Value="Да"/>
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Изменить" Command="{Binding EditCommand}" Padding="10,4" Margin="0,0,6,0"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,4"/>
            <TextBlock Text="Загрузка..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>