<UserControl x:Class="TradeSystem.App.Views.ShelfEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Редактирование полки"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter Property="Text" Value="Новая полка"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Код *" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,5" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Название *" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Расположение" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,5" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Например: склад A, зона 3"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Примечание" VerticalAlignment="Top" Margin="0,5"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,5" MinHeight="50"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <CheckBox Content="Полка активна" IsChecked="{Binding IsActive}" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}"
                        Padding="14,6" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="14,6"/>
                <TextBlock Text="Загрузка..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>