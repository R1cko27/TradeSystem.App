<UserControl x:Class="TradeSystem.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Справочные отчёты" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <!-- Панель выбора отчёта -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Отчёт:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="300" Margin="0,0,18,0"
                      ItemsSource="{Binding AvailableKinds}"
                      SelectedValuePath="Value" DisplayMemberPath="Label"
                      SelectedValue="{Binding SelectedKind}"/>

            <TextBlock Text="Поставщик:" VerticalAlignment="Center" Margin="0,0,6,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSupplierReport}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ComboBox Width="260" Margin="0,0,18,0"
                      ItemsSource="{Binding Suppliers}"
                      SelectedValuePath="Id" DisplayMemberPath="Name"
                      SelectedValue="{Binding SelectedSupplierId}">
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSupplierReport}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <Button Content="Сформировать" Command="{Binding GenerateCommand}" Padding="12,5" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Предпросмотр (тот же текст, что пойдёт на печать) -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Padding="10" Background="#FCFCFC"/>
        </Border>

        <!-- Действия вывода -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="🖨 Печать" Command="{Binding PrintCommand}" Padding="12,5" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <Button Content="Сохранить TXT" Command="{Binding SaveTextCommand}" Padding="12,5" Margin="0,0,8,0"/>
            <Button Content="Сохранить CSV" Command="{Binding SaveCsvCommand}" Padding="12,5"/>
            <TextBlock Text="Загрузка..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>