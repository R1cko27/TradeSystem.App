<UserControl x:Class="TradeSystem.App.Views.SupplierProductEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Редактирование поставки"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter Property="Text" Value="Новая поставка товара"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Товар *" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,5"
                          ItemsSource="{Binding Products}"
                          SelectedValuePath="Id" DisplayMemberPath="Name"
                          SelectedValue="{Binding ProductId}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Поставщик *" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,5"
                          ItemsSource="{Binding Suppliers}"
                          SelectedValuePath="Id" DisplayMemberPath="Name"
                          SelectedValue="{Binding SupplierId}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Артикул поставщика" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,5" Text="{Binding SupplierArticle, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Цена закупки" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,5" Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Оставьте пустым, если цена неизвестна."/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Срок поставки, дней" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,5" Text="{Binding LeadTimeText, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Мин. количество заказа" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,5" Text="{Binding MinOrderText, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Кратность заказа" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,5" Text="{Binding MultipleText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Например, 12 — заказывать только упаковками по 12 шт."/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Примечание" VerticalAlignment="Top" Margin="0,5"/>
                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,5" MinHeight="50"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <CheckBox Content="Предпочтительный поставщик для этого товара"
                      IsChecked="{Binding IsPreferred}" Margin="0,10,0,0"/>
            <CheckBox Content="Связь активна" IsChecked="{Binding IsActive}" Margin="0,4,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}"
                        Padding="14,6" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="14,6"/>
                <TextBlock Text="Загрузка..." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>